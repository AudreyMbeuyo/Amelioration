entity Horaire {
  // Attributs de Horaire
  jour Jour,
  heureDebut ZonedDateTime,
  heureFin ZonedDateTime
}

enum Jour{
LUNDI, MARDI, MERCREDI, JEUDI, VENDREDI, SAMEDI, DIMANCHE

}

entity Enseignant {
  // Attributs de Enseignant
  nom String,
  email String,
  password String
}

entity Matiere {
  // Attributs de Matiere
  libelle String,
  code String
}

entity Classe {
  // Attributs de Classe
  nom String
}

entity Departement{
  nom String
}

entity Etudiant {
  // Attributs de Etudiant
  matricule String,
  nom String,
  prenom String
}

entity Estpresent {
  date LocalDate
}

// Relations
relationship ManyToOne {
  Estpresent to Horaire
}

relationship ManyToOne {
  Estpresent to Etudiant
}


relationship ManyToOne {
  Matiere to Horaire
}

relationship ManyToOne {
  Matiere to Enseignant
}

relationship ManyToMany {
  Matiere to Classe
}

relationship ManyToMany {
  Classe to Etudiant
}

relationship ManyToMany {
  Etudiant to Matiere
}

relationship OneToOne {
 Enseignant to Departement
}

relationship OneToMany{
 Departement to Classe
}

